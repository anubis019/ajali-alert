# ── Ajali Alert System — Environment Variables ──
# Kenya Emergency Response Platform

# Application
APP_NAME=Ajali Alert System
APP_VERSION=2.0.0
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./ajali.db

# Authentication
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# USSD Gateway (Africa's Talking)
USSD_CODE=*1233#
USSD_SESSION_TIMEOUT=180
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SHORTCODE=12345

# SMS Gateway
SMS_PROVIDER=africas_talking
SMS_FROM=AJALI
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Emergency Response Thresholds (minutes)
GOLDEN_HOUR_ACCIDENT=5
GOLDEN_HOUR_FIRE=3
GOLDEN_HOUR_MEDICAL=4
GOLDEN_HOUR_SECURITY=5

# Escalation Check Interval (seconds)
ESCALATION_CHECK_INTERVAL=30

# Responder Capacity
MAX_ACTIVE_ALERTS_PER_RESPONDER=5
DISPATCH_TIMEOUT_SECONDS=120

# CORS
# CORS_ORIGINS=["http://localhost:3000","https://ajali-alert.vercel.app"]
